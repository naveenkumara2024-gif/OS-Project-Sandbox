{
  "_comment": "Human-owned ceiling policy (CLAUDE.md 6.4). Never mounted into a cell. A request may ask for less than the ceiling, never more. A file that is unreadable or invalid refuses every run; there is no built-in fallback.",
  "ingest_roots": [],
  "ingest_excludes": [
    ".ssh",
    ".aws",
    ".env",
    ".env.*",
    ".git/hooks",
    "node_modules",
    "dist",
    "*.key",
    "*.pem"
  ],
  "ceiling": {
    "limits": {
      "wall_ms": 60000,
      "output_kb": 1024,
      "memory_mb": 2048,
      "pids": 512,
      "cpu_percent": 400,
      "cpu_ms": 300000,
      "disk_mb": 256
    },
    "network_allow": [],
    "network_ports": [443],
    "require_at_least": ["caps_dropped", "no_new_privs", "seccomp"],
    "max_cells": 4,
    "memory_budget_mb": 4096,
    "max_sessions": 8,
    "session_idle_s": 1800
  }
}
